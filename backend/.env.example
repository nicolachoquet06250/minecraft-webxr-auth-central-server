# Database
DATABASE_URL=mysql://user:password@localhost:3306/voxicraft_central

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Discord OAuth (optionnel)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:8080/auth/discord/callback

# Server Configuration
API_PORT=8080

# CORS
CORS_ORIGIN=http://localhost:5176

# Domain (utilisé pour remplacer l'URL de l'API dans le frontend)
# En développement: http://localhost:8080
# En production: https://your-domain.com
DOMAIN=http://localhost:8080

# Environment
ENVIRONMENT=development
